{% doc %}
  @prompt
    Create a product-page size-first variant picker for clothing with Size and Print options, using the current product's actual variants and availability. Show Size first. After a shopper selects a size, show print choices with unavailable combinations visibly crossed out and disabled, so shoppers don't need to click every print to discover it is sold out. Available prints remain selectable. Update availability whenever size changes, prevent unavailable combinations from being added to cart, and ensure the selected available variant is the one added to cart. Use the actual product's option names and values, not hardcoded stock or print lists. Match the existing Dawn theme appearance, work well on mobile, and provide accessible selection and sold-out labels. Make this a product-page block intended to replace the existing variant picker, not duplicate it. Example use case: Flippy Skirt has Print and Size options; the customer selects L first and can immediately distinguish which prints are available in L.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign size_index = nil %}
{% assign print_index = nil %}
{% for option in product.options_with_values %}
  {% assign option_name = option.name | downcase %}
  {% if option_name == 'size' %}{% assign size_index = forloop.index0 %}{% endif %}
  {% if option_name == 'print' %}{% assign print_index = forloop.index0 %}{% endif %}
{% endfor %}
{% if product != blank and size_index != nil and print_index != nil %}
  {% assign size_option = product.options_with_values[size_index] %}
  {% assign print_option = product.options_with_values[print_index] %}
  {% assign initial_variant = product.selected_or_first_available_variant %}
  {% assign initial_size = initial_variant.options[size_index] %}
  {% assign initial_print = initial_variant.options[print_index] %}
  {% assign form_id = 'product-form-' | append: section.id %}
  {% style %}
    .ai-size-first-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; color:rgb(var(--color-foreground)); font-family:var(--font-body-family); }
    .ai-size-first-{{ ai_gen_id }} fieldset { border:0; margin:0 0 1.8rem; padding:0; min-width:0; }
    .ai-size-first-{{ ai_gen_id }} legend { font-size:1.4rem; margin-bottom:.8rem; font-weight:600; }
    .ai-size-first-{{ ai_gen_id }}__choices { display:flex; flex-wrap:wrap; gap:.8rem; }
    .ai-size-first-{{ ai_gen_id }}__choice { position:relative; }
    .ai-size-first-{{ ai_gen_id }}__input { position:absolute; width:1px; height:1px; opacity:0; }
    .ai-size-first-{{ ai_gen_id }}__label { min-width:4.4rem; min-height:4.4rem; padding:.8rem 1.2rem; border:1px solid rgba(var(--color-foreground),.55); border-radius:var(--variant-pills-radius, 40px); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:1.4rem; position:relative; }
    .ai-size-first-{{ ai_gen_id }}__input:checked + .ai-size-first-{{ ai_gen_id }}__label { background:rgb(var(--color-foreground)); color:rgb(var(--color-background)); box-shadow:0 0 0 .1rem rgb(var(--color-foreground)); }
    .ai-size-first-{{ ai_gen_id }}__input:focus-visible + .ai-size-first-{{ ai_gen_id }}__label { outline:.2rem solid currentColor; outline-offset:.3rem; }
    .ai-size-first-{{ ai_gen_id }}__input:disabled + .ai-size-first-{{ ai_gen_id }}__label { opacity:.48; cursor:not-allowed; text-decoration:line-through; }
    .ai-size-first-{{ ai_gen_id }}__input:disabled + .ai-size-first-{{ ai_gen_id }}__label::after { content:''; position:absolute; left:12%; right:12%; top:50%; border-top:1px solid currentColor; transform:rotate(-28deg); }
    .ai-size-first-{{ ai_gen_id }}__status { display:block; font-size:1.2rem; margin-top:.6rem; }
    .ai-size-first-{{ ai_gen_id }}__print[hidden] { display:none; }
    @media screen and (max-width:749px) { .ai-size-first-{{ ai_gen_id }} { width:100%; } .ai-size-first-{{ ai_gen_id }}__choices { gap:.7rem; } }
  {% endstyle %}
  <size-first-picker-{{ ai_gen_id }} class="ai-size-first-{{ ai_gen_id }}" data-product="{{ product | json | escape }}" data-size-index="{{ size_index }}" data-print-index="{{ print_index }}" data-form-id="{{ form_id }}" {{ block.shopify_attributes }}>
    <fieldset aria-label="{{ size_option.name | escape }}">
      <legend>{{ size_option.name | escape }}</legend>
      <div class="ai-size-first-{{ ai_gen_id }}__choices">
        {% for value in size_option.values %}
          {% assign size_available = false %}
          {% for variant in product.variants %}{% if variant.options[size_index] == value and variant.available %}{% assign size_available = true %}{% endif %}{% endfor %}
          {% assign checked = false %}{% if initial_size == value %}{% assign checked = true %}{% endif %}
          <span class="ai-size-first-{{ ai_gen_id }}__choice"><input class="ai-size-first-{{ ai_gen_id }}__input" type="radio" name="size-{{ ai_gen_id }}" id="{{ ai_gen_id }}-size-{{ forloop.index }}" value="{{ value | escape }}" {% if checked %}checked{% endif %} {% unless size_available %}disabled{% endunless %}><label class="ai-size-first-{{ ai_gen_id }}__label" for="{{ ai_gen_id }}-size-{{ forloop.index }}">{{ value | escape }}</label></span>
        {% endfor %}
      </div>
      <span class="ai-size-first-{{ ai_gen_id }}__status" data-size-status aria-live="polite"></span>
    </fieldset>
    <fieldset class="ai-size-first-{{ ai_gen_id }}__print" data-print-group aria-label="{{ print_option.name | escape }}" hidden>
      <legend>{{ print_option.name | escape }}</legend>
      <div class="ai-size-first-{{ ai_gen_id }}__choices">
        {% for value in print_option.values %}
          <span class="ai-size-first-{{ ai_gen_id }}__choice"><input class="ai-size-first-{{ ai_gen_id }}__input" type="radio" name="print-{{ ai_gen_id }}" id="{{ ai_gen_id }}-print-{{ forloop.index }}" value="{{ value | escape }}"><label class="ai-size-first-{{ ai_gen_id }}__label" for="{{ ai_gen_id }}-print-{{ forloop.index }}">{{ value | escape }}</label></span>
        {% endfor %}
      </div>
      <span class="ai-size-first-{{ ai_gen_id }}__status" data-print-status aria-live="polite"></span>
    </fieldset>
    <input type="hidden" name="id" value="{{ initial_variant.id }}" form="{{ form_id }}" data-variant-id>
    <p class="visually-hidden" data-picker-status aria-live="polite"></p>
  </size-first-picker-{{ ai_gen_id }}>
  <script>
    (() => {
      const tag = 'size-first-picker-{{ ai_gen_id }}';
      if (customElements.get(tag)) return;
      class SizeFirstPicker extends HTMLElement {
        connectedCallback() {
          try { this.product = JSON.parse(this.dataset.product); } catch (error) { return; }
          this.sizeIndex = Number(this.dataset.sizeIndex);
          this.printIndex = Number(this.dataset.printIndex);
          this.form = document.getElementById(this.dataset.formId);
          this.idInput = this.querySelector('[data-variant-id]');
          this.printGroup = this.querySelector('[data-print-group]');
          this.addEventListener('change', (event) => {
            if (event.target.matches('input[type="radio"]')) this.update();
          });
          if (this.form) this.form.addEventListener('submit', (event) => {
            const variant = this.selectedVariant;
            if (!variant || !variant.available) { event.preventDefault(); this.querySelector('[data-picker-status]').textContent = 'Please select an available size and print.'; }
          });
          const size = this.querySelector('input[name^="size-"]:checked');
          if (size) this.showPrints(size.value);
        }
        get selectedVariant() { return this.product.variants.find((variant) => String(variant.id) === this.idInput.value); }
        showPrints(sizeValue) {
          this.printGroup.hidden = false;
          let firstAvailable = null;
          this.printGroup.querySelectorAll('input[type="radio"]').forEach((input) => {
            const variant = this.product.variants.find((item) => item.options[this.sizeIndex] === sizeValue && item.options[this.printIndex] === input.value);
            input.disabled = !variant || !variant.available;
            input.checked = false;
            if (variant && variant.available && !firstAvailable) firstAvailable = input;
          });
          if (firstAvailable) firstAvailable.checked = true;
          this.updateVariant();
          this.querySelector('[data-print-status]').textContent = firstAvailable ? '' : 'No prints are available in this size.';
          this.querySelector('[data-size-status]').textContent = '';
        }
        update() {
          const size = this.querySelector('input[name^="size-"]:checked');
          if (!size) return;
          if (this.printGroup.hidden || !this.printGroup.dataset.started) {
            this.printGroup.dataset.started = 'true';
            this.showPrints(size.value);
            return;
          }
          if (this.contains(event?.target) && event.target.name.startsWith('size-')) this.showPrints(size.value);
          else this.updateVariant();
        }
        updateVariant() {
          const size = this.querySelector('input[name^="size-"]:checked');
          const print = this.querySelector('input[name^="print-"]:checked:not(:disabled)');
          const variant = size && print ? this.product.variants.find((item) => item.options[this.sizeIndex] === size.value && item.options[this.printIndex] === print.value) : null;
          if (variant && variant.available) {
            this.idInput.value = variant.id;
            this.idInput.dispatchEvent(new Event('change', { bubbles: true }));
            this.querySelector('[data-picker-status]').textContent = '';
          } else {
            this.idInput.value = '';
            this.querySelector('[data-picker-status]').textContent = 'This combination is unavailable.';
          }
        }
      }
      customElements.define(tag, SizeFirstPicker);
    })();
  </script>
{% endif %}
{% schema %}
{
  "name": "Size-first variants",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Size-first variants" }],
  "tag": null,
  "class": "size-first-variants"
}
{% endschema %}